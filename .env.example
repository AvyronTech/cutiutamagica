# Runtime configuration lives in wrangler.jsonc.
# Production secrets must be added with Wrangler, never committed here:
# npx wrangler secret put AVYRON_SYNC_HMAC_SECRET --env production
# npx wrangler secret put AVYRON_CRM_HMAC_SECRET --env production
# npx wrangler secret put FGO_PRIVATE_KEY --env production
# npx wrangler secret put STRIPE_SECRET_KEY --env production
# npx wrangler secret put STRIPE_WEBHOOK_SECRET --env production
# npx wrangler secret put SMARTSHIP_API_KEY --env production
# npx wrangler secret put SMARTSHIP_COD_IBAN --env production
# Autentificarea clienților prin Google OpenID Connect:
# npx wrangler secret put CUSTOMER_GOOGLE_CLIENT_ID --env production
# npx wrangler secret put CUSTOMER_GOOGLE_CLIENT_SECRET --env production
# Sign in with Apple (Service ID, Team ID, Key ID and .p8 key); callback:
# https://cutiutamagica.eu/api/v1/reviewer/oauth/apple/callback
# npx wrangler secret put CUSTOMER_APPLE_CLIENT_ID --env production
# npx wrangler secret put CUSTOMER_APPLE_TEAM_ID --env production
# npx wrangler secret put CUSTOMER_APPLE_KEY_ID --env production
# npx wrangler secret put CUSTOMER_APPLE_PRIVATE_KEY --env production
# Resend is an optional fallback while Cloudflare Email Sending is unavailable.
# npx wrangler secret put RESEND_API_KEY --env production
# npx wrangler secret put RESEND_MARKETING_API_KEY --env production
# npx wrangler secret put RESEND_WEBHOOK_SECRET --env production
#
# Cloudflare Access values are non-secret deployment configuration and must be
# completed in wrangler.jsonc before production deploy:
# CF_ACCESS_TEAM_DOMAIN
# CF_ACCESS_AUD
