{
  "name": "Cutiuța Magică Admin",
  "short_name": "Cutiuta Admin",
  "description": "Administrarea magazinului Cutiuța Magică",
  "id": "/admin",
  "start_url": "/admin?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0b1120",
  "theme_color": "#0b1120",
  "lang": "ro",
  "categories": ["business", "productivity", "shopping"],
  "prefer_related_applications": false,
  "shortcuts": [
    { "name": "Comenzi", "short_name": "Comenzi", "url": "/admin/orders?source=pwa" },
    { "name": "Produse", "short_name": "Produse", "url": "/admin/products?source=pwa" },
    { "name": "Chat clienți", "short_name": "Chat", "url": "/admin/chat?source=pwa" }
  ],
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
